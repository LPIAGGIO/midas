# worker jarvis
# Copiar a .env y completar. NO commitear el .env con valores reales.

# Bot PROPIO de Jarvis (BotFather). NO reusar el token de @midas_ar_BOT:
# dos procesos con getUpdates sobre el mismo token se roban los mensajes.
JARVIS_BOT_TOKEN=

# Clave de API de Anthropic (console.anthropic.com). Es lo que paga el cerebro.
ANTHROPIC_API_KEY=

# Supabase (service role key — bypassa RLS, secreto)
SUPABASE_URL=https://utcltvmhpmlgolzyzkvl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- opcionales (los defaults estan pensados para arrancar barato) ---
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium
JARVIS_MAX_TURNS=40
# Tope por consulta. Corta el turno si el costo estimado lo alcanza.
JARVIS_MAX_BUDGET_USD=1.0
# Tope por dia. Si se pasa, Jarvis se niega a arrancar turnos nuevos.
JARVIS_DAILY_BUDGET_USD=10
# Cuanto espera una confirmacion antes de darla por rechazada (ms).
JARVIS_APPROVAL_TIMEOUT_MS=600000
# Directorio de trabajo del agente. Ojo: es lo que puede leer y escribir.
JARVIS_WORKSPACE=/home/midas/jarvis-workspace
# JARVIS_DEBUG=1
